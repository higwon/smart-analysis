<Project Sdk="Microsoft.NET.Sdk">

  <!-- Role: headless analysis operations + numeric algorithms. Domain only. No UI/WPF/Infrastructure. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartAnalysis.Domain\SmartAnalysis.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- DI abstractions only (Approved, doc 20) — for the explicit per-module AddAnalysisOperation<T>
         registration (ADR-005). Not a container, not UI/viz/commercial. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <!-- Numerics (Approved, doc 20; MIT). Polynomial least-squares for Flatten — the same MathNet fits
         the MV00 golden was generated from, so the reused algorithm matches legacy. -->
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
  </ItemGroup>

</Project>

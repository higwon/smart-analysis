<Project Sdk="Microsoft.NET.Sdk">

  <!-- Role: FileFormats + Persistence + External adapters. Implements Application/Domain Ports.
       References Domain and Application ONLY (Application to implement its Ports — ADR-010).
       MUST NOT reference UI. Does not own Use Cases. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartAnalysis.Domain\SmartAnalysis.Domain.csproj" />
    <ProjectReference Include="..\SmartAnalysis.Application\SmartAnalysis.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- PSIA-TIFF reader (ADR-015): TiffLibrary (MIT), reader-only, isolated in Infrastructure behind
         the IScanFileReader port. DI abstractions for the explicit AddPsiaTiffReader() registration. -->
    <PackageReference Include="TiffLibrary" Version="0.6.65" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
  </ItemGroup>

</Project>

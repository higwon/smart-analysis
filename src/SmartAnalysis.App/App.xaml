<Application x:Class="SmartAnalysis.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <!--
        Composition root. The first-party design system (UIX03) is merged here so every window/control
        resolves SA.* tokens; ThemeManager (App.xaml.cs) swaps the Light/Dark palette at runtime.
        Still no StartupUri / MainWindow / DI wiring — the shell arrives at U01.
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SmartAnalysis.UI;component/DesignSystem/DesignSystem.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>

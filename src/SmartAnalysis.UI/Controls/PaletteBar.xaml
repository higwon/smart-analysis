<UserControl x:Class="SmartAnalysis.UI.Controls.PaletteBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Width="72">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top = data maximum -->
        <TextBlock x:Name="MaxLabel" Grid.Row="0" Style="{StaticResource SA.Text.Numeric}"
                   HorizontalAlignment="Center" Margin="{DynamicResource SA.Gap.Bottom1}"/>

        <!-- Gradient bar + draggable min/max handles (the axis spans the full data range) -->
        <Canvas x:Name="Track" Grid.Row="1" ClipToBounds="False" MinHeight="120" SizeChanged="Track_SizeChanged">
            <Border x:Name="Bar" Canvas.Left="34" Canvas.Top="0" Width="14"
                    BorderBrush="{DynamicResource SA.Brush.Border.Default}"
                    BorderThickness="{DynamicResource SA.Stroke.Hairline}"
                    CornerRadius="{DynamicResource SA.Radius.Sm}"/>

            <!-- Handles: triangles pointing right at the bar; centred on their value. Left-button drags them. -->
            <Polygon x:Name="MinHandle" Canvas.Left="18" Points="0,0 14,7 0,14" Cursor="SizeNS"
                     Fill="{DynamicResource SA.Brush.Accent.Primary}" Stroke="White" StrokeThickness="1"
                     Visibility="Collapsed"
                     MouseLeftButtonDown="MinHandle_MouseLeftButtonDown"
                     MouseLeftButtonUp="Handle_MouseLeftButtonUp"
                     MouseMove="Handle_MouseMove"/>
            <Polygon x:Name="MaxHandle" Canvas.Left="18" Points="0,0 14,7 0,14" Cursor="SizeNS"
                     Fill="{DynamicResource SA.Brush.Accent.Primary}" Stroke="White" StrokeThickness="1"
                     Visibility="Collapsed"
                     MouseLeftButtonDown="MaxHandle_MouseLeftButtonDown"
                     MouseLeftButtonUp="Handle_MouseLeftButtonUp"
                     MouseMove="Handle_MouseMove"/>
        </Canvas>

        <!-- Bottom = data minimum -->
        <TextBlock x:Name="MinLabel" Grid.Row="2" Style="{StaticResource SA.Text.Numeric}"
                   HorizontalAlignment="Center" Margin="{DynamicResource SA.Gap.Top2}"/>
        <TextBlock x:Name="UnitLabel" Grid.Row="3" Style="{StaticResource SA.Text.Micro}"
                   HorizontalAlignment="Center"/>
    </Grid>
</UserControl>

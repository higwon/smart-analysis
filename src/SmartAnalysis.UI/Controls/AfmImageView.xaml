<UserControl x:Class="SmartAnalysis.UI.Controls.AfmImageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource SA.Brush.Chart.Background}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Image viewport (zoom/pan) -->
        <Border x:Name="Viewport" Grid.Column="0" ClipToBounds="True" Background="Transparent"
                MouseWheel="Viewport_MouseWheel"
                MouseLeftButtonDown="Viewport_MouseLeftButtonDown"
                MouseLeftButtonUp="Viewport_MouseLeftButtonUp"
                MouseMove="Viewport_MouseMove"
                SizeChanged="Viewport_SizeChanged">
            <Image x:Name="Img" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top"
                   RenderOptions.BitmapScalingMode="NearestNeighbor" RenderTransformOrigin="0,0">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="ImgScale"/>
                        <TranslateTransform x:Name="ImgTranslate"/>
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>
        </Border>

        <!-- Colormap legend (palette) -->
        <StackPanel Grid.Column="1" Orientation="Vertical" Margin="{DynamicResource SA.Gap.3}"
                    VerticalAlignment="Stretch" Width="56">
            <TextBlock x:Name="MaxLabel" Style="{StaticResource SA.Text.Numeric}"
                       HorizontalAlignment="Center" Margin="{DynamicResource SA.Gap.Bottom1}"/>
            <Border x:Name="LegendBar" Width="12" MinHeight="120" HorizontalAlignment="Center"
                    BorderBrush="{DynamicResource SA.Brush.Border.Default}"
                    BorderThickness="{DynamicResource SA.Stroke.Hairline}"
                    CornerRadius="{DynamicResource SA.Radius.Sm}"/>
            <TextBlock x:Name="MinLabel" Style="{StaticResource SA.Text.Numeric}"
                       HorizontalAlignment="Center" Margin="{DynamicResource SA.Gap.Top2}"/>
            <TextBlock x:Name="UnitLabel" Style="{StaticResource SA.Text.Micro}"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>

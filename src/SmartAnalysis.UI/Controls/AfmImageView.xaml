<UserControl x:Class="SmartAnalysis.UI.Controls.AfmImageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:SmartAnalysis.UI.Controls"
             Background="{DynamicResource SA.Brush.Chart.Background}">
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- The vertical ruler's gutter. Collapsed to nothing when rulers are off. -->
            <ColumnDefinition x:Name="RulerColumn" Width="0"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition x:Name="RulerRow" Height="0"/>
        </Grid.RowDefinitions>

        <!-- Rulers live OUTSIDE the image, as legacy draws them: nothing is painted over pixel data, so nothing
             needs a halo to stay legible against an arbitrary colormap. -->
        <ctl:AfmRulerView x:Name="LeftRuler" Grid.Column="0" Grid.Row="0" Edge="Left" Visibility="Collapsed"/>
        <ctl:AfmRulerView x:Name="BottomRuler" Grid.Column="1" Grid.Row="1" Edge="Bottom" Visibility="Collapsed"/>

        <!-- Image viewport (zoom/pan) -->
        <Border x:Name="Viewport" Grid.Column="1" Grid.Row="0" ClipToBounds="True" Background="Transparent"
                MouseWheel="Viewport_MouseWheel"
                MouseLeftButtonDown="Viewport_MouseLeftButtonDown"
                MouseLeftButtonUp="Viewport_MouseLeftButtonUp"
                MouseMove="Viewport_MouseMove"
                SizeChanged="Viewport_SizeChanged">
            <!-- The Image sits on a Canvas so it is measured with an unconstrained size and thus arranged at
                 the bitmap's NATURAL pixel size. Directly inside the Border its arrange size was clamped to the
                 viewport, so a large scan (e.g. 4096²) was realized at viewport resolution and the zoom
                 RenderTransform then shrank that further — the image appeared tiny. On a Canvas the transform
                 scales the full-resolution content correctly. -->
            <Grid>
                <Canvas>
                    <Image x:Name="Img" Stretch="None"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" RenderTransformOrigin="0,0">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="ImgScale"/>
                                <TranslateTransform x:Name="ImgTranslate"/>
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                </Canvas>
                <!-- Overlay layer in screen space (constant stroke): the live region preview + its drag handles
                     (e.g. the Crop rectangle). Positioned from the image transform so it tracks pan/zoom. The
                     Canvas has no Background, so empty areas stay hit-transparent (the image still pans there);
                     only the region rectangle and handles receive the mouse. -->
                <Canvas x:Name="OverlayLayer">
                    <Rectangle x:Name="RegionOverlay" Visibility="Collapsed"
                               Stroke="{DynamicResource SA.Brush.Accent.Primary}" StrokeThickness="2"
                               Fill="{DynamicResource SA.Brush.Chart.Selection}"/>
                    <!-- Elliptical ROI: the inscribed ellipse; the rectangle above becomes a dashed bounding guide. -->
                    <Ellipse x:Name="RegionEllipseOverlay" Visibility="Collapsed" IsHitTestVisible="False"
                             Stroke="{DynamicResource SA.Brush.Accent.Primary}" StrokeThickness="2"
                             Fill="{DynamicResource SA.Brush.Chart.Selection}"/>
                    <!-- A wide transparent line under the visible one: it's what receives the mouse, so the thin
                         2px line is easy to grab and drag (a 2px hit target is missed too often). -->
                    <Line x:Name="LineHitArea" Visibility="Collapsed" Stroke="Transparent" StrokeThickness="14"/>
                    <!-- The profile line (endpoints are separate draggable handles built in code). -->
                    <Line x:Name="LineOverlay" Visibility="Collapsed" IsHitTestVisible="False"
                          Stroke="{DynamicResource SA.Brush.Accent.Primary}" StrokeThickness="2"/>
                </Canvas>
            </Grid>
        </Border>

        <!-- Interactive colormap legend / palette bar (draggable min/max handles set the value window) -->
        <ctl:PaletteBar x:Name="Palette" Grid.Column="2" Grid.Row="0" Margin="{DynamicResource SA.Gap.3}"
                        VerticalAlignment="Stretch"/>
    </Grid>
</UserControl>

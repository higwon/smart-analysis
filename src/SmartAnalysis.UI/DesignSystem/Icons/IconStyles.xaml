<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ds="clr-namespace:SmartAnalysis.UI.DesignSystem.Controls">
    <!--
        Default style for IconPresenter (UIX04). Strokes an SA.Icon.* geometry in Foreground (currentColor),
        scaling the 24-grid via a Viewbox so the 2px Lucide stroke stays proportional at any size. Foreground
        defaults to Text.Secondary; callers set an SA.Brush.* to recolor (it theme-swaps). The 24-grid Grid
        and round caps are template mechanics (doc 21 §6 exemption).
    -->
    <Style TargetType="{x:Type ds:IconPresenter}">
        <Setter Property="Width" Value="{DynamicResource SA.Size.Icon.Md}"/>
        <Setter Property="Height" Value="{DynamicResource SA.Size.Icon.Md}"/>
        <Setter Property="Foreground" Value="{DynamicResource SA.Brush.Text.Secondary}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ds:IconPresenter}">
                    <Viewbox Stretch="Uniform" SnapsToDevicePixels="True">
                        <Grid Width="{DynamicResource SA.Icon.Grid}" Height="{DynamicResource SA.Icon.Grid}">
                            <Path Data="{TemplateBinding Data}" Stretch="None"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="{DynamicResource SA.Icon.StrokeWidth}"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"/>
                        </Grid>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!--
        Theme-INDEPENDENT design tokens (doc 23 §4/§5/§6). Loaded once; not swapped with Light/Dark.
        Keys are namespaced 'SA.*'. Colors are NOT here (see Palettes/). Raw numeric literals are the
        token definitions themselves — the no-hardcoded-values rule allows metrics only in this file.
    -->

    <!-- ===== Typography: families ===== -->
    <FontFamily x:Key="SA.Font.Family.Ui">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="SA.Font.Family.Mono">Cascadia Mono, Consolas</FontFamily>
    <!-- weights: Regular 400 / Medium 500 / SemiBold 600 (Bold avoided) -->
    <FontWeight x:Key="SA.Font.Weight.Regular">Normal</FontWeight>
    <FontWeight x:Key="SA.Font.Weight.Medium">Medium</FontWeight>
    <FontWeight x:Key="SA.Font.Weight.SemiBold">SemiBold</FontWeight>
    <!-- type scale (size / line) -->
    <sys:Double x:Key="SA.Font.Size.Display">24</sys:Double>
    <sys:Double x:Key="SA.Font.Size.Title">18</sys:Double>
    <sys:Double x:Key="SA.Font.Size.Subtitle">15</sys:Double>
    <sys:Double x:Key="SA.Font.Size.Body">13</sys:Double>
    <sys:Double x:Key="SA.Font.Size.Caption">12</sys:Double>
    <sys:Double x:Key="SA.Font.Size.Micro">11</sys:Double>
    <sys:Double x:Key="SA.Font.Size.Numeric">13</sys:Double>
    <sys:Double x:Key="SA.Font.Line.Display">32</sys:Double>
    <sys:Double x:Key="SA.Font.Line.Title">26</sys:Double>
    <sys:Double x:Key="SA.Font.Line.Subtitle">22</sys:Double>
    <sys:Double x:Key="SA.Font.Line.Body">20</sys:Double>
    <sys:Double x:Key="SA.Font.Line.Caption">16</sys:Double>
    <sys:Double x:Key="SA.Font.Line.Micro">14</sys:Double>

    <!-- ===== Spacing scale (base unit 4) ===== -->
    <sys:Double x:Key="SA.Space.0">2</sys:Double>
    <sys:Double x:Key="SA.Space.1">4</sys:Double>
    <sys:Double x:Key="SA.Space.2">8</sys:Double>
    <sys:Double x:Key="SA.Space.3">12</sys:Double>
    <sys:Double x:Key="SA.Space.4">16</sys:Double>
    <sys:Double x:Key="SA.Space.5">24</sys:Double>
    <sys:Double x:Key="SA.Space.6">32</sys:Double>
    <sys:Double x:Key="SA.Space.7">48</sys:Double>
    <!-- common padding Thicknesses composed from the scale -->
    <Thickness x:Key="SA.Pad.Field">9,0,9,0</Thickness>
    <Thickness x:Key="SA.Pad.Button">14,0,14,0</Thickness>
    <Thickness x:Key="SA.Pad.Section">12</Thickness>
    <Thickness x:Key="SA.Pad.Panel">16</Thickness>

    <!-- ===== Sizing ===== -->
    <sys:Double x:Key="SA.Size.Control.Sm">24</sys:Double>
    <sys:Double x:Key="SA.Size.Control.Md">28</sys:Double>
    <sys:Double x:Key="SA.Size.Control.Lg">32</sys:Double>
    <sys:Double x:Key="SA.Size.Row.Compact">26</sys:Double>
    <sys:Double x:Key="SA.Size.Row.Comfortable">30</sys:Double>
    <sys:Double x:Key="SA.Size.Toolbar">40</sys:Double>
    <sys:Double x:Key="SA.Size.Header">44</sys:Double>
    <sys:Double x:Key="SA.Size.Icon.Sm">14</sys:Double>
    <sys:Double x:Key="SA.Size.Icon.Md">16</sys:Double>
    <sys:Double x:Key="SA.Size.Icon.Lg">20</sys:Double>

    <!-- ===== Radius ===== -->
    <CornerRadius x:Key="SA.Radius.None">0</CornerRadius>
    <CornerRadius x:Key="SA.Radius.Sm">2</CornerRadius>
    <CornerRadius x:Key="SA.Radius.Md">4</CornerRadius>
    <CornerRadius x:Key="SA.Radius.Lg">6</CornerRadius>

    <!-- ===== Border thickness ===== -->
    <Thickness x:Key="SA.Stroke.Hairline">1</Thickness>
    <Thickness x:Key="SA.Stroke.Strong">2</Thickness>
    <Thickness x:Key="SA.Stroke.Focus">2</Thickness>

    <!-- ===== Motion (minimal) ===== -->
    <Duration x:Key="SA.Duration.Fast">0:0:0.1</Duration>
    <Duration x:Key="SA.Duration.Base">0:0:0.16</Duration>
    <Duration x:Key="SA.Duration.Slow">0:0:0.24</Duration>
</ResourceDictionary>

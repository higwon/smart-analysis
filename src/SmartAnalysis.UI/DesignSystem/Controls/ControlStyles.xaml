<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ds="clr-namespace:SmartAnalysis.UI.DesignSystem.Controls">
    <!--
        Stock-control styles, layered Base -> Variant (doc 21 §6). Colors come from Palettes via
        DynamicResource (so a runtime theme swap re-binds live); design metrics from Tokens.

        No-hardcoded-values policy (enforced by DesignSystemStyleTests): raw hex lives ONLY in Palettes;
        SCREEN/view XAML must use tokens for hex + FontSize/Margin/Padding/CornerRadius (a separate test
        guards that). INSIDE these ControlTemplates, small implementation geometry (glyph box size, focus
        offset, state-layer, indent) MAY be literal — it is template mechanics, not a screen design metric;
        recurring design metrics still use SA.* tokens. Keyed styles (SA.*) are opt-in; implicit styles at
        the end give every stock control a product default so nothing renders unstyled.
    -->

    <!-- ===================== Focus visual (ring + offset, never color-only) ===================== -->
    <Style x:Key="SA.FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" SnapsToDevicePixels="True" RadiusX="3" RadiusY="3"
                               StrokeThickness="2" Stroke="{DynamicResource SA.Brush.Border.Focus}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Buttons ===================== -->
    <!--
        One shared template, reused by every variant. Resting fill = Background; the hover/pressed fills
        are INJECTED per variant via ds:ButtonChrome.HoverBackground/PressedBackground (state layers bind
        to them). This is why Danger no longer turns blue on hover: the interaction color is a per-variant
        token, not hard-referenced in the template's triggers. (Trigger Setters cannot hold a Binding in
        WPF, so the layers bind on the element and triggers only toggle their Opacity.)
    -->
    <ControlTemplate x:Key="SA.Template.Button" TargetType="{x:Type ButtonBase}">
        <Border x:Name="bd" Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{DynamicResource SA.Radius.Sm}" SnapsToDevicePixels="True">
            <Grid>
                <Border x:Name="hoverLayer" Opacity="0" CornerRadius="{DynamicResource SA.Radius.Sm}"
                        Background="{Binding Path=(ds:ButtonChrome.HoverBackground), RelativeSource={RelativeSource TemplatedParent}}"/>
                <Border x:Name="pressLayer" Opacity="0" CornerRadius="{DynamicResource SA.Radius.Sm}"
                        Background="{Binding Path=(ds:ButtonChrome.PressedBackground), RelativeSource={RelativeSource TemplatedParent}}"/>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="hoverLayer" Property="Opacity" Value="1"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="pressLayer" Property="Opacity" Value="1"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SA.Brush.Surface.Disabled}"/>
                <Setter TargetName="hoverLayer" Property="Opacity" Value="0"/>
                <Setter TargetName="pressLayer" Property="Opacity" Value="0"/>
                <Setter Property="Foreground" Value="{DynamicResource SA.Brush.Text.Disabled}"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Base: shared metrics/typography + the neutral (secondary) fill + neutral hover/pressed. -->
    <Style x:Key="SA.Button.Base" TargetType="{x:Type ButtonBase}">
        <Setter Property="Height" Value="{DynamicResource SA.Size.Control.Md}"/>
        <Setter Property="Padding" Value="{DynamicResource SA.Pad.Button}"/>
        <Setter Property="FontFamily" Value="{DynamicResource SA.Font.Family.Ui}"/>
        <Setter Property="FontSize" Value="{DynamicResource SA.Font.Size.Body}"/>
        <Setter Property="FontWeight" Value="{DynamicResource SA.Font.Weight.SemiBold}"/>
        <Setter Property="Foreground" Value="{DynamicResource SA.Brush.Text.Primary}"/>
        <Setter Property="Background" Value="{DynamicResource SA.Brush.Surface.Default}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SA.Brush.Border.Default}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource SA.Stroke.Hairline}"/>
        <Setter Property="ds:ButtonChrome.HoverBackground" Value="{DynamicResource SA.Brush.Surface.Hover}"/>
        <Setter Property="ds:ButtonChrome.PressedBackground" Value="{DynamicResource SA.Brush.Surface.Pressed}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource SA.FocusVisual}"/>
        <Setter Property="Template" Value="{StaticResource SA.Template.Button}"/>
    </Style>

    <Style x:Key="SA.Button.Secondary" TargetType="{x:Type Button}" BasedOn="{StaticResource SA.Button.Base}"/>

    <!-- Primary: accent fill, white text, accent hover/pressed (one per region). -->
    <Style x:Key="SA.Button.Primary" TargetType="{x:Type Button}" BasedOn="{StaticResource SA.Button.Base}">
        <Setter Property="Background" Value="{DynamicResource SA.Brush.Accent.Primary}"/>
        <Setter Property="Foreground" Value="{DynamicResource SA.Brush.Text.OnAccent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SA.Brush.Accent.Primary}"/>
        <Setter Property="ds:ButtonChrome.HoverBackground" Value="{DynamicResource SA.Brush.Accent.PrimaryHover}"/>
        <Setter Property="ds:ButtonChrome.PressedBackground" Value="{DynamicResource SA.Brush.Accent.PrimaryPressed}"/>
    </Style>

    <!-- Danger: dedicated danger fill (NOT the Status.Error text token) + danger hover/pressed. White text
         stays AA on all three states in both themes. This variant now darkens (not turns blue) on hover. -->
    <Style x:Key="SA.Button.Danger" TargetType="{x:Type Button}" BasedOn="{StaticResource SA.Button.Base}">
        <Setter Property="Background" Value="{DynamicResource SA.Brush.Control.Danger}"/>
        <Setter Property="Foreground" Value="{DynamicResource SA.Brush.Text.OnAccent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SA.Brush.Control.Danger}"/>
        <Setter Property="ds:ButtonChrome.HoverBackground" Value="{DynamicResource SA.Brush.Control.DangerHover}"/>
        <Setter Property="ds:ButtonChrome.PressedBackground" Value="{DynamicResource SA.Brush.Control.DangerPressed}"/>
    </Style>

    <!-- Icon: square, transparent, neutral hover/pressed. -->
    <Style x:Key="SA.Button.Icon" TargetType="{x:Type Button}" BasedOn="{StaticResource SA.Button.Base}">
        <Setter Property="Width" Value="{DynamicResource SA.Size.Control.Md}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource SA.Brush.Text.Secondary}"/>
    </Style>

    <!-- Toolbar: transparent, compact, neutral hover/pressed. -->
    <Style x:Key="SA.Button.Toolbar" TargetType="{x:Type Button}" BasedOn="{StaticResource SA.Button.Base}">
        <Setter Property="Padding" Value="{DynamicResource SA.Pad.Field}"/>
        <Setter Property="FontWeight" Value="{DynamicResource SA.Font.Weight.Regular}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource SA.Brush.Text.Secondary}"/>
    </Style>

    <!-- ===================== ToggleButton + Segmented ===================== -->
    <Style x:Key="SA.Toggle.Base" TargetType="{x:Type ToggleButton}">
        <Setter Property="Height" Value="{DynamicResource SA.Size.Control.Md}"/>
        <Setter Property="Padding" Value="{DynamicResource SA.Pad.Field}"/>
        <Setter Property="FontFamily" Value="{DynamicResource SA.Font.Family.Ui}"/>
        <Setter Property="FontSize" Value="{DynamicResource SA.Font.Size.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource SA.Brush.Text.Secondary}"/>
        <Setter Property="Background" Value="{DynamicResource SA.Brush.Surface.Default}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SA.Brush.Border.Default}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource SA.Stroke.Hairline}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource SA.FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource SA.Radius.Sm}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource SA.Brush.Surface.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource SA.Brush.Surface.Selected}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource SA.Brush.Accent.Primary}"/>
                            <Setter Property="Foreground" Value="{DynamicResource SA.Brush.Accent.OnSurface}"/>
                            <Setter Property="FontWeight" Value="{DynamicResource SA.Font.Weight.SemiBold}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource SA.Brush.Text.Disabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Segmented member = the same toggle used in a horizontal group (e.g. flatten Scope). -->
    <Style x:Key="SA.Toggle.Segmented" TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource SA.Toggle.Base}"/>

    <!-- ===================== TextBox ===================== -->
    <Style x:Key="SA.TextBox" TargetType="{x:Type TextBox}">
        <Setter Property="Height" Value="{DynamicResource SA.Size.Control.Md}"/>
        <Setter Property="Padding" Value="{DynamicResource SA.Pad.Field}"/>
        <Setter Property="FontFamily" Value="{DynamicResource SA.Font.Family.Ui}"/>
        <Setter Property="FontSize" Value="{DynamicResource SA.Font.Size.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource SA.Brush.Text.Primary}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource SA.Brush.Text.Primary}"/>
        <Setter Property="Background" Value="{DynamicResource SA.Brush.Surface.Default}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SA.Brush.Border.Default}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource SA.Stroke.Hairline}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource SA.Radius.Sm}" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource SA.Brush.Border.Focus}"/>
                            <Setter TargetName="bd" Property="BorderThickness" Value="{DynamicResource SA.Stroke.Focus}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource SA.Brush.Surface.Disabled}"/>
                            <Setter Property="Foreground" Value="{DynamicResource SA.Brush.Text.Disabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource SA.TextBox}"/>

    <!-- ===================== CheckBox ===================== -->
    <Style x:Key="SA.CheckBox" TargetType="{x:Type CheckBox}">
        <Setter Property="FontFamily" Value="{DynamicResource SA.Font.Family.Ui}"/>
        <Setter Property="FontSize" Value="{DynamicResource SA.Font.Size.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource SA.Brush.Text.Secondary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource SA.FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="box" Width="16" Height="16" CornerRadius="{DynamicResource SA.Radius.Sm}"
                                Background="{DynamicResource SA.Brush.Surface.Default}"
                                BorderBrush="{DynamicResource SA.Brush.Border.Strong}"
                                BorderThickness="{DynamicResource SA.Stroke.Hairline}" SnapsToDevicePixels="True">
                            <Path x:Name="check" Visibility="Collapsed" Stretch="Uniform" Margin="3"
                                  Stroke="{DynamicResource SA.Brush.Text.OnAccent}" StrokeThickness="2"
                                  Data="M 0,5 L 4,9 L 11,0"/>
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{DynamicResource SA.Brush.Accent.Primary}"/>
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource SA.Brush.Accent.Primary}"/>
                            <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource SA.Brush.Text.Disabled}"/>
                            <Setter TargetName="box" Property="Background" Value="{DynamicResource SA.Brush.Surface.Disabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource SA.CheckBox}"/>

    <!-- ===================== ListBox + item ===================== -->
    <Style x:Key="SA.ListBoxItem" TargetType="{x:Type ListBoxItem}">
        <Setter Property="MinHeight" Value="{DynamicResource SA.Size.Row.Comfortable}"/>
        <Setter Property="Padding" Value="{DynamicResource SA.Pad.Field}"/>
        <Setter Property="FontFamily" Value="{DynamicResource SA.Font.Family.Ui}"/>
        <Setter Property="FontSize" Value="{DynamicResource SA.Font.Size.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource SA.Brush.Text.Primary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource SA.Brush.Surface.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource SA.Brush.Surface.Selected}"/>
                            <Setter Property="Foreground" Value="{DynamicResource SA.Brush.Accent.OnSurface}"/>
                            <Setter Property="FontWeight" Value="{DynamicResource SA.Font.Weight.SemiBold}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource SA.ListBoxItem}"/>
    <Style x:Key="SA.ListBox" TargetType="{x:Type ListBox}">
        <Setter Property="Background" Value="{DynamicResource SA.Brush.Surface.Default}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SA.Brush.Border.Default}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource SA.Stroke.Hairline}"/>
    </Style>
    <Style TargetType="{x:Type ListBox}" BasedOn="{StaticResource SA.ListBox}"/>

    <!-- ===================== TreeView + item (Explorer lineage) ===================== -->
    <Style x:Key="SA.TreeViewItem" TargetType="{x:Type TreeViewItem}">
        <Setter Property="FontFamily" Value="{DynamicResource SA.Font.Family.Ui}"/>
        <Setter Property="FontSize" Value="{DynamicResource SA.Font.Size.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource SA.Brush.Text.Primary}"/>
        <Setter Property="Padding" Value="4,0,0,0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TreeViewItem}">
                    <StackPanel>
                        <Border x:Name="bd" MinHeight="{DynamicResource SA.Size.Row.Comfortable}"
                                Background="Transparent" SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="PART_Header" ContentSource="Header"
                                              VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ItemsPresenter x:Name="items" Margin="14,0,0,0"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="items" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource SA.Brush.Surface.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource SA.Brush.Surface.Selected}"/>
                            <Setter Property="Foreground" Value="{DynamicResource SA.Brush.Accent.OnSurface}"/>
                            <Setter Property="FontWeight" Value="{DynamicResource SA.Font.Weight.SemiBold}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource SA.TreeViewItem}"/>
    <Style x:Key="SA.TreeView" TargetType="{x:Type TreeView}">
        <Setter Property="Background" Value="{DynamicResource SA.Brush.Background.Sidebar}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style TargetType="{x:Type TreeView}" BasedOn="{StaticResource SA.TreeView}"/>

    <!-- ===================== TabControl + TabItem ===================== -->
    <Style x:Key="SA.TabItem" TargetType="{x:Type TabItem}">
        <Setter Property="FontFamily" Value="{DynamicResource SA.Font.Family.Ui}"/>
        <Setter Property="FontSize" Value="{DynamicResource SA.Font.Size.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource SA.Brush.Text.Secondary}"/>
        <Setter Property="Padding" Value="12,6,12,6"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource SA.FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Border x:Name="bd" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent">
                        <ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource SA.Brush.Text.Primary}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource SA.Brush.Accent.Primary}"/>
                            <Setter Property="Foreground" Value="{DynamicResource SA.Brush.Text.Primary}"/>
                            <Setter Property="FontWeight" Value="{DynamicResource SA.Font.Weight.SemiBold}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type TabItem}" BasedOn="{StaticResource SA.TabItem}"/>
    <Style TargetType="{x:Type TabControl}">
        <Setter Property="Background" Value="{DynamicResource SA.Brush.Surface.Default}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SA.Brush.Border.Default}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <!-- Two rows + two columns so the tab strip can move to any TabStripPlacement; the
                         TabPanel itself arranges the headers per placement. Default is Top. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ColumnDefinition0" Width="*"/>
                            <ColumnDefinition x:Name="ColumnDefinition1" Width="0"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="RowDefinition0" Height="Auto"/>
                            <RowDefinition x:Name="RowDefinition1" Height="*"/>
                        </Grid.RowDefinitions>
                        <Border x:Name="HeaderBorder" Grid.Row="0" Grid.Column="0" Panel.ZIndex="1"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{DynamicResource SA.Stroke.Hairline.Bottom}">
                            <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1"/>
                        </Border>
                        <Border x:Name="ContentBorder" Grid.Row="1" Grid.Column="0" Background="{TemplateBinding Background}">
                            <ContentPresenter ContentSource="SelectedContent" Margin="{DynamicResource SA.Pad.Panel}"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="TabStripPlacement" Value="Bottom">
                            <Setter TargetName="HeaderBorder" Property="Grid.Row" Value="1"/>
                            <Setter TargetName="ContentBorder" Property="Grid.Row" Value="0"/>
                            <Setter TargetName="RowDefinition0" Property="Height" Value="*"/>
                            <Setter TargetName="RowDefinition1" Property="Height" Value="Auto"/>
                            <Setter TargetName="HeaderBorder" Property="BorderThickness" Value="{DynamicResource SA.Stroke.Hairline.Top}"/>
                        </Trigger>
                        <Trigger Property="TabStripPlacement" Value="Left">
                            <Setter TargetName="HeaderBorder" Property="Grid.RowSpan" Value="2"/>
                            <Setter TargetName="ContentBorder" Property="Grid.Row" Value="0"/>
                            <Setter TargetName="ContentBorder" Property="Grid.RowSpan" Value="2"/>
                            <Setter TargetName="ContentBorder" Property="Grid.Column" Value="1"/>
                            <Setter TargetName="ColumnDefinition0" Property="Width" Value="Auto"/>
                            <Setter TargetName="ColumnDefinition1" Property="Width" Value="*"/>
                            <Setter TargetName="RowDefinition0" Property="Height" Value="*"/>
                            <Setter TargetName="RowDefinition1" Property="Height" Value="0"/>
                            <Setter TargetName="HeaderBorder" Property="BorderThickness" Value="{DynamicResource SA.Stroke.Hairline.Right}"/>
                        </Trigger>
                        <Trigger Property="TabStripPlacement" Value="Right">
                            <Setter TargetName="HeaderBorder" Property="Grid.RowSpan" Value="2"/>
                            <Setter TargetName="HeaderBorder" Property="Grid.Column" Value="1"/>
                            <Setter TargetName="ContentBorder" Property="Grid.Row" Value="0"/>
                            <Setter TargetName="ContentBorder" Property="Grid.RowSpan" Value="2"/>
                            <Setter TargetName="ColumnDefinition0" Property="Width" Value="*"/>
                            <Setter TargetName="ColumnDefinition1" Property="Width" Value="Auto"/>
                            <Setter TargetName="RowDefinition0" Property="Height" Value="*"/>
                            <Setter TargetName="RowDefinition1" Property="Height" Value="0"/>
                            <Setter TargetName="HeaderBorder" Property="BorderThickness" Value="{DynamicResource SA.Stroke.Hairline.Left}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== ProgressBar (inline, determinate) ===================== -->
    <Style x:Key="SA.ProgressBar" TargetType="{x:Type ProgressBar}">
        <Setter Property="Height" Value="4"/>
        <Setter Property="Background" Value="{DynamicResource SA.Brush.Border.Default}"/>
        <Setter Property="Foreground" Value="{DynamicResource SA.Brush.Accent.Primary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource SA.Radius.Sm}"
                            SnapsToDevicePixels="True" ClipToBounds="True">
                        <Grid>
                            <Rectangle x:Name="PART_Track"/>
                            <Rectangle x:Name="PART_Indicator" HorizontalAlignment="Left"
                                       Fill="{TemplateBinding Foreground}" RadiusX="2" RadiusY="2"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type ProgressBar}" BasedOn="{StaticResource SA.ProgressBar}"/>

    <!-- ===================== ToolTip ===================== -->
    <Style TargetType="{x:Type ToolTip}">
        <Setter Property="FontFamily" Value="{DynamicResource SA.Font.Family.Ui}"/>
        <Setter Property="FontSize" Value="{DynamicResource SA.Font.Size.Caption}"/>
        <Setter Property="Foreground" Value="{DynamicResource SA.Brush.Text.Primary}"/>
        <Setter Property="Background" Value="{DynamicResource SA.Brush.Surface.Raised}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SA.Brush.Border.Default}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource SA.Stroke.Hairline}"/>
        <Setter Property="Padding" Value="8,4,8,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToolTip}">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource SA.Radius.Md}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Separator ===================== -->
    <Style TargetType="{x:Type Separator}">
        <Setter Property="Background" Value="{DynamicResource SA.Brush.Border.Subtle}"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="0,4,0,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Border Height="{TemplateBinding Height}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Segmented control (single-select, horizontal ListBox) ===================== -->
    <Style x:Key="SA.Segmented" TargetType="{x:Type ListBox}">
        <Setter Property="Background" Value="{DynamicResource SA.Brush.Surface.Default}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SA.Brush.Border.Default}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource SA.Stroke.Hairline}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="ItemsPanel">
            <Setter.Value><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBox}">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource SA.Radius.Sm}" SnapsToDevicePixels="True">
                        <ItemsPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SA.Segmented.Item" TargetType="{x:Type ListBoxItem}">
        <Setter Property="FontFamily" Value="{DynamicResource SA.Font.Family.Ui}"/>
        <Setter Property="FontSize" Value="{DynamicResource SA.Font.Size.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource SA.Brush.Text.Secondary}"/>
        <Setter Property="MinHeight" Value="{DynamicResource SA.Size.Control.Md}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="bd" Background="Transparent" Padding="{DynamicResource SA.Pad.Field}" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource SA.Brush.Surface.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource SA.Brush.Surface.Selected}"/>
                            <Setter Property="Foreground" Value="{DynamicResource SA.Brush.Accent.OnSurface}"/>
                            <Setter Property="FontWeight" Value="{DynamicResource SA.Font.Weight.SemiBold}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Base-setter styles (default template, tokenized) — extensible ===================== -->
    <!-- These give the remaining stock controls consistent color/typography/metrics now; full templates
         are added incrementally as screens need them (doc 21 §7 "extensible"). No hard-coded values. -->
    <!-- ComboBox — fully re-templated (a setter-only style leaves the default WPF chrome, whose toggle
         button paints system-grey regardless of theme: unreadable text on the wrong ground, esp. in Dark).
         The closed box + chevron, the drop-down, and the items all use SA brushes so both themes read right. -->
    <Style x:Key="SA.ComboBoxItem" TargetType="{x:Type ComboBoxItem}">
        <Setter Property="MinHeight" Value="{DynamicResource SA.Size.Row.Comfortable}"/>
        <Setter Property="Padding" Value="{DynamicResource SA.Pad.Field}"/>
        <Setter Property="FontFamily" Value="{DynamicResource SA.Font.Family.Ui}"/>
        <Setter Property="FontSize" Value="{DynamicResource SA.Font.Size.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource SA.Brush.Text.Primary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}"
                            CornerRadius="{DynamicResource SA.Radius.Sm}" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource SA.Brush.Surface.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource SA.Brush.Surface.Selected}"/>
                            <Setter Property="Foreground" Value="{DynamicResource SA.Brush.Accent.OnSurface}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource SA.Brush.Text.Disabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type ComboBoxItem}" BasedOn="{StaticResource SA.ComboBoxItem}"/>

    <!-- The closed box (a ToggleButton that opens the drop-down): border + chevron, no content (the
         ComboBox template overlays the selected item over column 0). -->
    <ControlTemplate x:Key="SA.ComboBox.ToggleTemplate" TargetType="{x:Type ToggleButton}">
        <Border x:Name="bd" Background="{DynamicResource SA.Brush.Surface.Default}"
                BorderBrush="{DynamicResource SA.Brush.Border.Default}"
                BorderThickness="{DynamicResource SA.Stroke.Hairline}"
                CornerRadius="{DynamicResource SA.Radius.Sm}" SnapsToDevicePixels="True">
            <ds:IconPresenter HorizontalAlignment="Right" VerticalAlignment="Center" Width="14" Height="14"
                              Margin="{DynamicResource SA.Gap.Right2}"
                              Data="{DynamicResource SA.Icon.ChevronDown}"
                              Foreground="{DynamicResource SA.Brush.Text.Secondary}"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource SA.Brush.Border.Strong}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource SA.Brush.Border.Focus}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="SA.ComboBox" TargetType="{x:Type ComboBox}">
        <Setter Property="Height" Value="{DynamicResource SA.Size.Control.Md}"/>
        <Setter Property="Padding" Value="{DynamicResource SA.Pad.Field}"/>
        <Setter Property="FontFamily" Value="{DynamicResource SA.Font.Family.Ui}"/>
        <Setter Property="FontSize" Value="{DynamicResource SA.Font.Size.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource SA.Brush.Text.Primary}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                      OverridesDefaultStyle="True"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Template="{StaticResource SA.ComboBox.ToggleTemplate}"/>
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          Margin="9,0,30,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                          SnapsToDevicePixels="True"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" PopupAnimation="Slide">
                            <Border MinWidth="{Binding ActualWidth, ElementName=ToggleButton}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,2,0,0"
                                    Background="{DynamicResource SA.Brush.Surface.Raised}"
                                    BorderBrush="{DynamicResource SA.Brush.Border.Default}"
                                    BorderThickness="{DynamicResource SA.Stroke.Hairline}"
                                    CornerRadius="{DynamicResource SA.Radius.Sm}">
                                <ScrollViewer>
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource SA.Brush.Text.Disabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource SA.ComboBox}"/>
    <Style x:Key="SA.RadioButton" TargetType="{x:Type RadioButton}">
        <Setter Property="FontFamily" Value="{DynamicResource SA.Font.Family.Ui}"/>
        <Setter Property="FontSize" Value="{DynamicResource SA.Font.Size.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource SA.Brush.Text.Primary}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <StackPanel Orientation="Horizontal" Background="Transparent" SnapsToDevicePixels="True">
                        <Grid Width="16" Height="16" VerticalAlignment="Center">
                            <Ellipse x:Name="outer" StrokeThickness="1.5"
                                     Stroke="{DynamicResource SA.Brush.Border.Strong}"
                                     Fill="{DynamicResource SA.Brush.Surface.Default}"/>
                            <Ellipse x:Name="dot" Width="8" Height="8" Visibility="Collapsed"
                                     Fill="{DynamicResource SA.Brush.Accent.Primary}"/>
                        </Grid>
                        <ContentPresenter Margin="{DynamicResource SA.Gap.Left2}" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="outer" Property="Stroke" Value="{DynamicResource SA.Brush.Accent.Primary}"/>
                            <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="outer" Property="Stroke" Value="{DynamicResource SA.Brush.Accent.Primary}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource SA.Brush.Text.Disabled}"/>
                            <Setter TargetName="outer" Property="Stroke" Value="{DynamicResource SA.Brush.Border.Default}"/>
                            <Setter TargetName="dot" Property="Fill" Value="{DynamicResource SA.Brush.Text.Disabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type RadioButton}" BasedOn="{StaticResource SA.RadioButton}"/>
    <Style x:Key="SA.Slider.Thumb" TargetType="{x:Type Thumb}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Ellipse x:Name="e" Fill="{DynamicResource SA.Brush.Accent.Primary}"
                             Stroke="{DynamicResource SA.Brush.Surface.Default}" StrokeThickness="2"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="e" Property="Fill" Value="{DynamicResource SA.Brush.Accent.PrimaryHover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="e" Property="Fill" Value="{DynamicResource SA.Brush.Text.Disabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SA.Slider.SideButton" TargetType="{x:Type RepeatButton}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}"><Border Background="Transparent"/></ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <ControlTemplate x:Key="SA.Slider.Horizontal" TargetType="{x:Type Slider}">
        <Grid VerticalAlignment="Center">
            <Border Height="4" VerticalAlignment="Center"
                    Background="{TemplateBinding Background}" CornerRadius="{DynamicResource SA.Radius.Pill}"/>
            <Track x:Name="PART_Track" Orientation="Horizontal">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource SA.Slider.SideButton}" Command="{x:Static Slider.DecreaseLarge}"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource SA.Slider.Thumb}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource SA.Slider.SideButton}" Command="{x:Static Slider.IncreaseLarge}"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="SA.Slider.Vertical" TargetType="{x:Type Slider}">
        <Grid HorizontalAlignment="Center">
            <Border Width="4" HorizontalAlignment="Center"
                    Background="{TemplateBinding Background}" CornerRadius="{DynamicResource SA.Radius.Pill}"/>
            <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource SA.Slider.SideButton}" Command="{x:Static Slider.DecreaseLarge}"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource SA.Slider.Thumb}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource SA.Slider.SideButton}" Command="{x:Static Slider.IncreaseLarge}"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>
    <Style x:Key="SA.Slider" TargetType="{x:Type Slider}">
        <Setter Property="Foreground" Value="{DynamicResource SA.Brush.Accent.Primary}"/>
        <Setter Property="Background" Value="{DynamicResource SA.Brush.Border.Default}"/>
        <Setter Property="MinHeight" Value="20"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template" Value="{StaticResource SA.Slider.Horizontal}"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Template" Value="{StaticResource SA.Slider.Vertical}"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="MinWidth" Value="20"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="{x:Type Slider}" BasedOn="{StaticResource SA.Slider}"/>
    <Style x:Key="SA.Expander" TargetType="{x:Type Expander}">
        <Setter Property="FontFamily" Value="{DynamicResource SA.Font.Family.Ui}"/>
        <Setter Property="FontSize" Value="{DynamicResource SA.Font.Size.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource SA.Brush.Text.Primary}"/>
        <Setter Property="Background" Value="{DynamicResource SA.Brush.Surface.Default}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Expander}">
                    <DockPanel>
                        <ToggleButton x:Name="Header" DockPanel.Dock="Top" Focusable="False"
                                      OverridesDefaultStyle="True" Padding="{DynamicResource SA.Gap.2}"
                                      Content="{TemplateBinding Header}"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Border x:Name="hb" Background="Transparent" Padding="{TemplateBinding Padding}"
                                            CornerRadius="{DynamicResource SA.Radius.Sm}">
                                        <StackPanel Orientation="Horizontal">
                                            <ds:IconPresenter x:Name="chev" Width="14" Height="14" VerticalAlignment="Center"
                                                              Margin="{DynamicResource SA.Gap.Right2}"
                                                              Data="{DynamicResource SA.Icon.ChevronRight}"
                                                              Foreground="{DynamicResource SA.Brush.Text.Secondary}"/>
                                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="hb" Property="Background" Value="{DynamicResource SA.Brush.Surface.Hover}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="chev" Property="RenderTransform">
                                                <Setter.Value><RotateTransform Angle="90" CenterX="7" CenterY="7"/></Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Border x:Name="Content" Background="{TemplateBinding Background}"
                                Padding="{DynamicResource SA.Pad.Panel}" Visibility="Collapsed">
                            <ContentPresenter/>
                        </Border>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Content" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <!-- ExpandDirection: dock the header so content grows the correct way (default Down). -->
                        <Trigger Property="ExpandDirection" Value="Up">
                            <Setter TargetName="Header" Property="DockPanel.Dock" Value="Bottom"/>
                        </Trigger>
                        <Trigger Property="ExpandDirection" Value="Right">
                            <Setter TargetName="Header" Property="DockPanel.Dock" Value="Left"/>
                        </Trigger>
                        <Trigger Property="ExpandDirection" Value="Left">
                            <Setter TargetName="Header" Property="DockPanel.Dock" Value="Right"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type Expander}" BasedOn="{StaticResource SA.Expander}"/>
    <Style TargetType="{x:Type Menu}">
        <Setter Property="FontFamily" Value="{DynamicResource SA.Font.Family.Ui}"/>
        <Setter Property="FontSize" Value="{DynamicResource SA.Font.Size.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource SA.Brush.Text.Primary}"/>
        <Setter Property="Background" Value="{DynamicResource SA.Brush.Background.Toolbar}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Menu}">
                    <Border Background="{TemplateBinding Background}" Padding="{DynamicResource SA.Gap.1}">
                        <ItemsPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Leaf item in a drop-down: [icon][header][gesture]. -->
    <ControlTemplate x:Key="SA.MenuItem.SubmenuItem" TargetType="{x:Type MenuItem}">
        <Border x:Name="bd" Background="Transparent" Padding="{DynamicResource SA.Pad.Field}"
                CornerRadius="{DynamicResource SA.Radius.Sm}" SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Margin="{DynamicResource SA.Gap.Right2}">
                    <ContentPresenter x:Name="Icon" ContentSource="Icon" VerticalAlignment="Center"/>
                    <ds:IconPresenter x:Name="Check" Width="14" Height="14" VerticalAlignment="Center" Visibility="Collapsed"
                                      Data="{DynamicResource SA.Icon.Check}" Foreground="{DynamicResource SA.Brush.Accent.OnSurface}"/>
                </Grid>
                <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" VerticalAlignment="Center"
                           Margin="{DynamicResource SA.Gap.Left2}" Foreground="{DynamicResource SA.Brush.Text.Tertiary}"/>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <!-- Checkable item: show a non-colour checkmark when checked (preserves WPF check semantics). -->
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SA.Brush.Surface.Hover}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource SA.Brush.Text.Disabled}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Drop-down item that opens a submenu: adds a right chevron + the child popup. -->
    <ControlTemplate x:Key="SA.MenuItem.SubmenuHeader" TargetType="{x:Type MenuItem}">
        <Border x:Name="bd" Background="Transparent" Padding="{DynamicResource SA.Pad.Field}"
                CornerRadius="{DynamicResource SA.Radius.Sm}" SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ContentPresenter Grid.Column="0" ContentSource="Icon" VerticalAlignment="Center" Margin="{DynamicResource SA.Gap.Right2}"/>
                <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                <ds:IconPresenter Grid.Column="2" Width="14" Height="14" VerticalAlignment="Center" Margin="{DynamicResource SA.Gap.Left2}"
                                  Data="{DynamicResource SA.Icon.ChevronRight}" Foreground="{DynamicResource SA.Brush.Text.Secondary}"/>
                <Popup x:Name="PART_Popup" Placement="Right" IsOpen="{TemplateBinding IsSubmenuOpen}"
                       AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                    <Border Background="{DynamicResource SA.Brush.Surface.Raised}"
                            BorderBrush="{DynamicResource SA.Brush.Border.Default}"
                            BorderThickness="{DynamicResource SA.Stroke.Hairline}"
                            CornerRadius="{DynamicResource SA.Radius.Sm}" Padding="{DynamicResource SA.Gap.1}" Margin="2,0,0,0">
                        <ItemsPresenter/>
                    </Border>
                </Popup>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SA.Brush.Surface.Hover}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource SA.Brush.Text.Disabled}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Menu-bar leaf. -->
    <ControlTemplate x:Key="SA.MenuItem.TopLevelItem" TargetType="{x:Type MenuItem}">
        <Border x:Name="bd" Background="Transparent" Padding="{DynamicResource SA.Pad.Field}"
                CornerRadius="{DynamicResource SA.Radius.Sm}" SnapsToDevicePixels="True">
            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SA.Brush.Surface.Hover}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Menu-bar item that opens a drop-down. -->
    <ControlTemplate x:Key="SA.MenuItem.TopLevelHeader" TargetType="{x:Type MenuItem}">
        <Border x:Name="bd" Background="Transparent" Padding="{DynamicResource SA.Pad.Field}"
                CornerRadius="{DynamicResource SA.Radius.Sm}" SnapsToDevicePixels="True">
            <Grid>
                <ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsSubmenuOpen}"
                       AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                    <Border Background="{DynamicResource SA.Brush.Surface.Raised}"
                            BorderBrush="{DynamicResource SA.Brush.Border.Default}"
                            BorderThickness="{DynamicResource SA.Stroke.Hairline}"
                            CornerRadius="{DynamicResource SA.Radius.Sm}" Padding="{DynamicResource SA.Gap.1}" Margin="0,2,0,0">
                        <ItemsPresenter/>
                    </Border>
                </Popup>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SA.Brush.Surface.Hover}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type MenuItem}">
        <Setter Property="FontFamily" Value="{DynamicResource SA.Font.Family.Ui}"/>
        <Setter Property="FontSize" Value="{DynamicResource SA.Font.Size.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource SA.Brush.Text.Primary}"/>
        <Setter Property="Template" Value="{StaticResource SA.MenuItem.SubmenuItem}"/>
        <Style.Triggers>
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter Property="Template" Value="{StaticResource SA.MenuItem.TopLevelHeader}"/>
            </Trigger>
            <Trigger Property="Role" Value="TopLevelItem">
                <Setter Property="Template" Value="{StaticResource SA.MenuItem.TopLevelItem}"/>
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{StaticResource SA.MenuItem.SubmenuHeader}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="FontFamily" Value="{DynamicResource SA.Font.Family.Ui}"/>
        <Setter Property="FontSize" Value="{DynamicResource SA.Font.Size.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource SA.Brush.Text.Primary}"/>
        <Setter Property="Background" Value="{DynamicResource SA.Brush.Surface.Raised}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SA.Brush.Border.Default}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource SA.Stroke.Hairline}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource SA.Radius.Md}" Padding="{DynamicResource SA.Gap.1}">
                        <ItemsPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- DataGrid — the control template respects the SA setters; the chrome that the WPF default paints with
         system colours (column headers, cell selection) is re-templated in the part styles below. -->
    <!-- Resize handles: column grippers are a vertical edge (SizeWE); row grippers are a horizontal edge
         that stretches across the row-header width (SizeNS). Same invisible hit-target template. -->
    <Style x:Key="SA.DataGrid.ColumnGripper" TargetType="{x:Type Thumb}">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="SizeWE"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}"><Border Background="{TemplateBinding Background}"/></ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SA.DataGrid.RowGripper" TargetType="{x:Type Thumb}">
        <Setter Property="Height" Value="8"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="SizeNS"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}"><Border Background="{TemplateBinding Background}"/></ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="Background" Value="{DynamicResource SA.Brush.Surface.Sunken}"/>
        <Setter Property="Foreground" Value="{DynamicResource SA.Brush.Text.Secondary}"/>
        <Setter Property="FontFamily" Value="{DynamicResource SA.Font.Family.Ui}"/>
        <Setter Property="FontSize" Value="{DynamicResource SA.Font.Size.Caption}"/>
        <Setter Property="Padding" Value="{DynamicResource SA.Pad.Field}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DataGridColumnHeader}">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                                BorderBrush="{DynamicResource SA.Brush.Border.Default}" BorderThickness="0,0,1,1" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" VerticalAlignment="Center"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                <!-- Sort direction glyph (▼ descending; rotated 180° for ascending). -->
                                <Path x:Name="SortArrow" Grid.Column="1" VerticalAlignment="Center" Visibility="Collapsed"
                                      Width="8" Height="6" Stretch="Fill" Margin="{DynamicResource SA.Gap.Left2}"
                                      Fill="{DynamicResource SA.Brush.Text.Secondary}" Data="M 0,0 L 8,0 L 4,6 Z"/>
                            </Grid>
                        </Border>
                        <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Style="{StaticResource SA.DataGrid.ColumnGripper}"/>
                        <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Style="{StaticResource SA.DataGrid.ColumnGripper}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="SortDirection" Value="Ascending">
                            <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="SortArrow" Property="RenderTransform">
                                <Setter.Value><RotateTransform Angle="180" CenterX="4" CenterY="3"/></Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Descending">
                            <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Row header (grip + selection marker area). Kept themed so HeadersVisibility=Row/All reads right. -->
    <Style TargetType="{x:Type DataGridRowHeader}">
        <Setter Property="Background" Value="{DynamicResource SA.Brush.Surface.Sunken}"/>
        <Setter Property="Foreground" Value="{DynamicResource SA.Brush.Text.Tertiary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DataGridRowHeader}">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True"
                                BorderBrush="{DynamicResource SA.Brush.Border.Default}" BorderThickness="0,0,1,1">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <Thumb x:Name="PART_TopHeaderGripper" VerticalAlignment="Top" Style="{StaticResource SA.DataGrid.RowGripper}"/>
                        <Thumb x:Name="PART_BottomHeaderGripper" VerticalAlignment="Bottom" Style="{StaticResource SA.DataGrid.RowGripper}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type DataGridCell}">
        <Setter Property="Foreground" Value="{DynamicResource SA.Brush.Text.Primary}"/>
        <Setter Property="Padding" Value="{DynamicResource SA.Pad.Field}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DataGridCell}">
                    <Border x:Name="bd" Background="Transparent" BorderThickness="0" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource SA.Brush.Surface.Selected}"/>
                            <Setter Property="Foreground" Value="{DynamicResource SA.Brush.Accent.OnSurface}"/>
                        </Trigger>
                        <!-- Validation: a red-tinted cell (the default adorner is theme-agnostic). -->
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource SA.Brush.Banner.Error.Background}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource SA.Brush.Status.Error}"/>
                            <Setter TargetName="bd" Property="BorderThickness" Value="{DynamicResource SA.Stroke.Hairline}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type DataGridRow}">
        <Setter Property="Background" Value="{DynamicResource SA.Brush.Surface.Default}"/>
        <Setter Property="Foreground" Value="{DynamicResource SA.Brush.Text.Primary}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SA.Brush.Surface.Hover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="{x:Type DataGrid}">
        <Setter Property="FontFamily" Value="{DynamicResource SA.Font.Family.Ui}"/>
        <Setter Property="FontSize" Value="{DynamicResource SA.Font.Size.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource SA.Brush.Text.Primary}"/>
        <Setter Property="Background" Value="{DynamicResource SA.Brush.Surface.Default}"/>
        <Setter Property="RowBackground" Value="{DynamicResource SA.Brush.Surface.Default}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SA.Brush.Border.Default}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource SA.Stroke.Hairline}"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource SA.Brush.Border.Subtle}"/>
        <Setter Property="RowHeight" Value="{DynamicResource SA.Size.Row.Comfortable}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DataGrid}">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource SA.Radius.Sm}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="DG_ScrollViewer" Focusable="False" Padding="{TemplateBinding Padding}">
                            <ScrollViewer.Template>
                                <ControlTemplate TargetType="{x:Type ScrollViewer}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <!-- Select-all corner (shown when both row + column headers are visible). -->
                                        <Button Grid.Row="0" Grid.Column="0" Focusable="False" Command="{x:Static DataGrid.SelectAllCommand}"
                                                Width="{Binding CellsPanelHorizontalOffset, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                Visibility="{Binding HeadersVisibility, ConverterParameter={x:Static DataGridHeadersVisibility.All}, Converter={x:Static DataGrid.HeadersVisibilityConverter}, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="{x:Type Button}">
                                                    <Border Background="{DynamicResource SA.Brush.Surface.Sunken}" SnapsToDevicePixels="True"
                                                            BorderBrush="{DynamicResource SA.Brush.Border.Default}" BorderThickness="0,0,1,1"/>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <DataGridColumnHeadersPresenter x:Name="PART_ColumnHeadersPresenter" Grid.Row="0" Grid.Column="1"
                                                Visibility="{Binding HeadersVisibility, ConverterParameter={x:Static DataGridHeadersVisibility.Column}, Converter={x:Static DataGrid.HeadersVisibilityConverter}, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"/>
                                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                                CanContentScroll="{TemplateBinding CanContentScroll}"/>
                                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Row="1" Grid.Column="2" Orientation="Vertical"
                                                   Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                                                   Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                                        <!-- Horizontal scrollbar offset past the frozen columns so it aligns with the scrollable area. -->
                                        <Grid Grid.Row="2" Grid.Column="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{Binding NonFrozenColumnsViewportHorizontalOffset, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Column="1" Orientation="Horizontal"
                                                       Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}"
                                                       Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
                                        </Grid>
                                    </Grid>
                                </ControlTemplate>
                            </ScrollViewer.Template>
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================================
         ScrollBar — thin, chrome-less, themed. A rounded thumb over a transparent track, no
         arrow buttons (modern overlay style). Thumb tone brightens on hover/drag. Applied as the
         implicit default so every ScrollViewer (Navigator tree, Inspector, provenance list, multi-
         line text) themes with the palette instead of the grey Windows default (notably in Dark).
         Reuses existing neutral brushes — no new palette keys.
         =================================================================================== -->
    <!-- The scroll-axis minimum drag length is set per-orientation on the Thumb INSTANCE in the ScrollBar
         template (MinHeight for vertical, MinWidth for horizontal) — never both here, or the thumb's
         cross-axis minimum would exceed the 10px track and overflow/clip. -->
    <Style x:Key="SA.ScrollBar.Thumb" TargetType="{x:Type Thumb}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border x:Name="Bar" Margin="2"
                            Background="{DynamicResource SA.Brush.Border.Strong}"
                            CornerRadius="{DynamicResource SA.Radius.Pill}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource SA.Brush.Text.Tertiary}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource SA.Brush.Text.Secondary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Track page-region buttons: invisible, non-focusable (thumb-only interaction + page-click). -->
    <Style x:Key="SA.ScrollBar.PageButton" TargetType="{x:Type RepeatButton}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="{TemplateBinding Background}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SA.ScrollBar" TargetType="{x:Type ScrollBar}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <!-- Vertical is the default; the Horizontal trigger below flips direction, moves the
                         minimum drag length to the X axis, and switches to the left/right page commands. -->
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton x:Name="DecreaseButton" Style="{StaticResource SA.ScrollBar.PageButton}" Command="{x:Static ScrollBar.PageUpCommand}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="Thumb" Style="{StaticResource SA.ScrollBar.Thumb}" MinHeight="24"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton x:Name="IncreaseButton" Style="{StaticResource SA.ScrollBar.PageButton}" Command="{x:Static ScrollBar.PageDownCommand}"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            <Setter TargetName="Thumb" Property="MinHeight" Value="0"/>
                            <Setter TargetName="Thumb" Property="MinWidth" Value="24"/>
                            <Setter TargetName="DecreaseButton" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}"/>
                            <Setter TargetName="IncreaseButton" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="MinHeight" Value="10"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource SA.ScrollBar}"/>
</ResourceDictionary>

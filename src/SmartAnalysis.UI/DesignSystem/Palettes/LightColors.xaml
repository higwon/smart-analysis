<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Semantic color tokens — LIGHT (doc 23 §2/§3). Theme-swapped at runtime by ThemeManager.
        DarkColors.xaml MUST declare the IDENTICAL set of x:Key values (enforced by
        DesignSystemStyleTests). Each token is provided twice: a Color (SA.Color.*) and a
        SolidColorBrush (SA.Brush.*). Views/controls bind the Brush via DynamicResource so a runtime
        swap re-binds live. Raw hex lives ONLY in these palette files (the no-hardcoded-values rule).

        NOT here: the AFM data colormap. It is domain-owned and theme-independent (ADR-008, doc 15).
    -->

    <!-- ===== Background ===== -->
    <Color x:Key="SA.Color.Background.App">#FFF7F8FA</Color>
    <Color x:Key="SA.Color.Background.Sidebar">#FFEEF0F3</Color>
    <Color x:Key="SA.Color.Background.Toolbar">#FFFFFFFF</Color>
    <!-- ===== Surface ===== -->
    <Color x:Key="SA.Color.Surface.Default">#FFFFFFFF</Color>
    <Color x:Key="SA.Color.Surface.Raised">#FFFFFFFF</Color>
    <Color x:Key="SA.Color.Surface.Sunken">#FFEEF0F3</Color>
    <Color x:Key="SA.Color.Surface.Overlay">#FFFFFFFF</Color>
    <Color x:Key="SA.Color.Surface.Hover">#FFEEF0F3</Color>
    <Color x:Key="SA.Color.Surface.Pressed">#FFE2E5EA</Color>
    <Color x:Key="SA.Color.Surface.Selected">#FFE8F0FE</Color>
    <Color x:Key="SA.Color.Surface.Disabled">#FFEEF0F3</Color>
    <!-- ===== Border ===== -->
    <Color x:Key="SA.Color.Border.Default">#FFE2E5EA</Color>
    <Color x:Key="SA.Color.Border.Subtle">#FFEEF0F3</Color>
    <Color x:Key="SA.Color.Border.Strong">#FFCBD0D8</Color>
    <Color x:Key="SA.Color.Border.Focus">#FF3B82F6</Color>
    <!-- ===== Text ===== -->
    <Color x:Key="SA.Color.Text.Primary">#FF171B22</Color>
    <Color x:Key="SA.Color.Text.Secondary">#FF5B6472</Color>
    <Color x:Key="SA.Color.Text.Tertiary">#FF7C8494</Color>
    <Color x:Key="SA.Color.Text.Disabled">#FFA7AEB9</Color>
    <Color x:Key="SA.Color.Text.OnAccent">#FFFFFFFF</Color>
    <!-- ===== Accent ===== -->
    <Color x:Key="SA.Color.Accent.Primary">#FF2563EB</Color>
    <Color x:Key="SA.Color.Accent.PrimaryHover">#FF1D4ED8</Color>
    <Color x:Key="SA.Color.Accent.PrimaryPressed">#FF1E40AF</Color>
    <Color x:Key="SA.Color.Accent.OnSurface">#FF2563EB</Color>
    <Color x:Key="SA.Color.Accent.Secondary">#FF60A5FA</Color>
    <!-- ===== Status (on-App-bg text/icon tokens) ===== -->
    <Color x:Key="SA.Color.Status.Success">#FF15803D</Color>
    <Color x:Key="SA.Color.Status.Warning">#FFB45309</Color>
    <Color x:Key="SA.Color.Status.Error">#FFDC2626</Color>
    <Color x:Key="SA.Color.Status.Info">#FF2563EB</Color>
    <!-- ===== Status inline banners (fg/bg pairs; Error fg is the AA-fixed #B91C1C on tint) ===== -->
    <Color x:Key="SA.Color.Banner.Success.Foreground">#FF15803D</Color>
    <Color x:Key="SA.Color.Banner.Success.Background">#FFDCFCE7</Color>
    <Color x:Key="SA.Color.Banner.Warning.Foreground">#FFB45309</Color>
    <Color x:Key="SA.Color.Banner.Warning.Background">#FFFEF3C7</Color>
    <Color x:Key="SA.Color.Banner.Error.Foreground">#FFB91C1C</Color>
    <Color x:Key="SA.Color.Banner.Error.Background">#FFFEE2E2</Color>
    <Color x:Key="SA.Color.Banner.Info.Foreground">#FF1D4ED8</Color>
    <Color x:Key="SA.Color.Banner.Info.Background">#FFDBEAFE</Color>
    <!-- ===== Chart/Image UI chrome (NOT the data colormap) ===== -->
    <Color x:Key="SA.Color.Chart.Background">#FFFFFFFF</Color>
    <Color x:Key="SA.Color.Chart.Grid">#FFEEF0F3</Color>
    <Color x:Key="SA.Color.Chart.Axis">#FF5B6472</Color>
    <Color x:Key="SA.Color.Chart.Label">#FF414956</Color>
    <Color x:Key="SA.Color.Chart.Cursor">#FF2563EB</Color>
    <Color x:Key="SA.Color.Chart.Reference">#FF7C8494</Color>
    <Color x:Key="SA.Color.Chart.Query">#FF2563EB</Color>
    <Color x:Key="SA.Color.Chart.Difference">#FFB45309</Color>
    <Color x:Key="SA.Color.Image.RoiBorder">#FF2563EB</Color>
    <Color x:Key="SA.Color.Image.Crosshair">#FF171B22</Color>
    <Color x:Key="SA.Color.Image.Selection">#FF2563EB</Color>

    <!-- ===== Brushes (what views actually consume, via DynamicResource) ===== -->
    <SolidColorBrush x:Key="SA.Brush.Background.App" Color="{StaticResource SA.Color.Background.App}"/>
    <SolidColorBrush x:Key="SA.Brush.Background.Sidebar" Color="{StaticResource SA.Color.Background.Sidebar}"/>
    <SolidColorBrush x:Key="SA.Brush.Background.Toolbar" Color="{StaticResource SA.Color.Background.Toolbar}"/>
    <SolidColorBrush x:Key="SA.Brush.Surface.Default" Color="{StaticResource SA.Color.Surface.Default}"/>
    <SolidColorBrush x:Key="SA.Brush.Surface.Raised" Color="{StaticResource SA.Color.Surface.Raised}"/>
    <SolidColorBrush x:Key="SA.Brush.Surface.Sunken" Color="{StaticResource SA.Color.Surface.Sunken}"/>
    <SolidColorBrush x:Key="SA.Brush.Surface.Overlay" Color="{StaticResource SA.Color.Surface.Overlay}"/>
    <SolidColorBrush x:Key="SA.Brush.Surface.Hover" Color="{StaticResource SA.Color.Surface.Hover}"/>
    <SolidColorBrush x:Key="SA.Brush.Surface.Pressed" Color="{StaticResource SA.Color.Surface.Pressed}"/>
    <SolidColorBrush x:Key="SA.Brush.Surface.Selected" Color="{StaticResource SA.Color.Surface.Selected}"/>
    <SolidColorBrush x:Key="SA.Brush.Surface.Disabled" Color="{StaticResource SA.Color.Surface.Disabled}"/>
    <SolidColorBrush x:Key="SA.Brush.Border.Default" Color="{StaticResource SA.Color.Border.Default}"/>
    <SolidColorBrush x:Key="SA.Brush.Border.Subtle" Color="{StaticResource SA.Color.Border.Subtle}"/>
    <SolidColorBrush x:Key="SA.Brush.Border.Strong" Color="{StaticResource SA.Color.Border.Strong}"/>
    <SolidColorBrush x:Key="SA.Brush.Border.Focus" Color="{StaticResource SA.Color.Border.Focus}"/>
    <SolidColorBrush x:Key="SA.Brush.Text.Primary" Color="{StaticResource SA.Color.Text.Primary}"/>
    <SolidColorBrush x:Key="SA.Brush.Text.Secondary" Color="{StaticResource SA.Color.Text.Secondary}"/>
    <SolidColorBrush x:Key="SA.Brush.Text.Tertiary" Color="{StaticResource SA.Color.Text.Tertiary}"/>
    <SolidColorBrush x:Key="SA.Brush.Text.Disabled" Color="{StaticResource SA.Color.Text.Disabled}"/>
    <SolidColorBrush x:Key="SA.Brush.Text.OnAccent" Color="{StaticResource SA.Color.Text.OnAccent}"/>
    <SolidColorBrush x:Key="SA.Brush.Accent.Primary" Color="{StaticResource SA.Color.Accent.Primary}"/>
    <SolidColorBrush x:Key="SA.Brush.Accent.PrimaryHover" Color="{StaticResource SA.Color.Accent.PrimaryHover}"/>
    <SolidColorBrush x:Key="SA.Brush.Accent.PrimaryPressed" Color="{StaticResource SA.Color.Accent.PrimaryPressed}"/>
    <SolidColorBrush x:Key="SA.Brush.Accent.OnSurface" Color="{StaticResource SA.Color.Accent.OnSurface}"/>
    <SolidColorBrush x:Key="SA.Brush.Accent.Secondary" Color="{StaticResource SA.Color.Accent.Secondary}"/>
    <SolidColorBrush x:Key="SA.Brush.Status.Success" Color="{StaticResource SA.Color.Status.Success}"/>
    <SolidColorBrush x:Key="SA.Brush.Status.Warning" Color="{StaticResource SA.Color.Status.Warning}"/>
    <SolidColorBrush x:Key="SA.Brush.Status.Error" Color="{StaticResource SA.Color.Status.Error}"/>
    <SolidColorBrush x:Key="SA.Brush.Status.Info" Color="{StaticResource SA.Color.Status.Info}"/>
    <SolidColorBrush x:Key="SA.Brush.Banner.Success.Foreground" Color="{StaticResource SA.Color.Banner.Success.Foreground}"/>
    <SolidColorBrush x:Key="SA.Brush.Banner.Success.Background" Color="{StaticResource SA.Color.Banner.Success.Background}"/>
    <SolidColorBrush x:Key="SA.Brush.Banner.Warning.Foreground" Color="{StaticResource SA.Color.Banner.Warning.Foreground}"/>
    <SolidColorBrush x:Key="SA.Brush.Banner.Warning.Background" Color="{StaticResource SA.Color.Banner.Warning.Background}"/>
    <SolidColorBrush x:Key="SA.Brush.Banner.Error.Foreground" Color="{StaticResource SA.Color.Banner.Error.Foreground}"/>
    <SolidColorBrush x:Key="SA.Brush.Banner.Error.Background" Color="{StaticResource SA.Color.Banner.Error.Background}"/>
    <SolidColorBrush x:Key="SA.Brush.Banner.Info.Foreground" Color="{StaticResource SA.Color.Banner.Info.Foreground}"/>
    <SolidColorBrush x:Key="SA.Brush.Banner.Info.Background" Color="{StaticResource SA.Color.Banner.Info.Background}"/>
    <SolidColorBrush x:Key="SA.Brush.Chart.Background" Color="{StaticResource SA.Color.Chart.Background}"/>
    <SolidColorBrush x:Key="SA.Brush.Chart.Grid" Color="{StaticResource SA.Color.Chart.Grid}"/>
    <SolidColorBrush x:Key="SA.Brush.Chart.Axis" Color="{StaticResource SA.Color.Chart.Axis}"/>
    <SolidColorBrush x:Key="SA.Brush.Chart.Label" Color="{StaticResource SA.Color.Chart.Label}"/>
    <SolidColorBrush x:Key="SA.Brush.Chart.Cursor" Color="{StaticResource SA.Color.Chart.Cursor}"/>
    <SolidColorBrush x:Key="SA.Brush.Chart.Reference" Color="{StaticResource SA.Color.Chart.Reference}"/>
    <SolidColorBrush x:Key="SA.Brush.Chart.Query" Color="{StaticResource SA.Color.Chart.Query}"/>
    <SolidColorBrush x:Key="SA.Brush.Chart.Difference" Color="{StaticResource SA.Color.Chart.Difference}"/>
    <SolidColorBrush x:Key="SA.Brush.Chart.Selection" Opacity="0.15" Color="{StaticResource SA.Color.Chart.Cursor}"/>
    <SolidColorBrush x:Key="SA.Brush.Image.RoiBorder" Color="{StaticResource SA.Color.Image.RoiBorder}"/>
    <SolidColorBrush x:Key="SA.Brush.Image.RoiFill" Opacity="0.12" Color="{StaticResource SA.Color.Image.RoiBorder}"/>
    <SolidColorBrush x:Key="SA.Brush.Image.Crosshair" Color="{StaticResource SA.Color.Image.Crosshair}"/>
    <SolidColorBrush x:Key="SA.Brush.Image.Selection" Color="{StaticResource SA.Color.Image.Selection}"/>
</ResourceDictionary>

<Window x:Class="SmartAnalysis.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ds="clr-namespace:SmartAnalysis.UI.DesignSystem.Controls"
        xmlns:ctl="clr-namespace:SmartAnalysis.UI.Controls"
        xmlns:conv="clr-namespace:SmartAnalysis.UI.Converters"
        xmlns:vm="clr-namespace:SmartAnalysis.UI.ViewModels"
        Title="SmartAnalysis" Height="720" Width="1180" MinHeight="520" MinWidth="900"
        Background="{DynamicResource SA.Brush.Background.App}"
        TextElement.Foreground="{DynamicResource SA.Brush.Text.Primary}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Bool2Vis"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="NotBool2Vis"/>
        <conv:ResourceKeyToGeometryConverter x:Key="Key2Geo"/>

        <!-- Explorer lineage node: accent rail + dot when active; icon + label; measurement marker. -->
        <HierarchicalDataTemplate DataType="{x:Type vm:DatasetNodeViewModel}" ItemsSource="{Binding Children}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="2" Background="{DynamicResource SA.Brush.Accent.Primary}"
                        Margin="{DynamicResource SA.Gap.Right2}"
                        Visibility="{Binding IsActive, Converter={StaticResource Bool2Vis}}"/>
                <ds:IconPresenter Grid.Column="1" Data="{Binding IconKey, Converter={StaticResource Key2Geo}}"
                                  Margin="{DynamicResource SA.Gap.Right2}"/>
                <TextBlock Grid.Column="2" Text="{Binding Label}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Style="{StaticResource SA.Text.Body}"/>
                <!-- comparison membership: a small "vs" badge (text, not color-only) — doc 24 -->
                <Border Grid.Column="3" VerticalAlignment="Center" Margin="{DynamicResource SA.Gap.Right2}"
                        Background="{DynamicResource SA.Brush.Surface.Hover}"
                        BorderBrush="{DynamicResource SA.Brush.Border.Default}"
                        BorderThickness="{DynamicResource SA.Stroke.Hairline}"
                        CornerRadius="{DynamicResource SA.Radius.Sm}" Padding="{DynamicResource SA.Gap.1}"
                        Visibility="{Binding IsInComparison, Converter={StaticResource Bool2Vis}}">
                    <TextBlock Text="vs" Style="{StaticResource SA.Text.Micro}"
                               Foreground="{DynamicResource SA.Brush.Accent.OnSurface}"/>
                </Border>
                <ds:IconPresenter Grid.Column="4" Data="{StaticResource SA.Icon.Dot}"
                                  Foreground="{DynamicResource SA.Brush.Accent.OnSurface}"
                                  Visibility="{Binding IsActive, Converter={StaticResource Bool2Vis}}"/>
            </Grid>
        </HierarchicalDataTemplate>

        <!-- History row. Status maps to a live DynamicResource icon+brush (theme-aware) via triggers. -->
        <DataTemplate DataType="{x:Type vm:HistoryRowViewModel}">
            <Grid Margin="{DynamicResource SA.Gap.Bottom1}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ds:IconPresenter x:Name="StatusIcon" Grid.Column="0" Width="14" Height="14"
                                  Data="{DynamicResource SA.Icon.Check}"
                                  Foreground="{DynamicResource SA.Brush.Status.Success}"/>
                <TextBlock Grid.Column="1" Text="{Binding Order}" Style="{StaticResource SA.Text.Micro}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding Operation}" VerticalAlignment="Center"
                           Margin="{DynamicResource SA.Gap.Right2}" Style="{StaticResource SA.Text.Body}"/>
                <TextBlock Grid.Column="3" Text="{Binding Parameters}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Style="{StaticResource SA.Text.Caption}"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Running">
                    <Setter TargetName="StatusIcon" Property="Data" Value="{DynamicResource SA.Icon.Refresh}"/>
                    <Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource SA.Brush.Accent.OnSurface}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter TargetName="StatusIcon" Property="Data" Value="{DynamicResource SA.Icon.Error}"/>
                    <Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource SA.Brush.Status.Error}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ Command bar ============ -->
        <Border Grid.Row="0" Style="{StaticResource SA.Toolbar}">
            <Grid Margin="{DynamicResource SA.Pad.Bar}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: workspace identity + primary actions -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="16" Height="16" CornerRadius="{DynamicResource SA.Radius.Sm}"
                            Background="{DynamicResource SA.Brush.Accent.Primary}" Margin="{DynamicResource SA.Gap.Right2}"/>
                    <TextBlock Text="{Binding WorkspaceName}" VerticalAlignment="Center"
                               Style="{StaticResource SA.Text.Subtitle}"/>
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource SA.Brush.Accent.Primary}"
                             Margin="{DynamicResource SA.Gap.Left2}" VerticalAlignment="Center"
                             Visibility="{Binding HasUnsavedChanges, Converter={StaticResource Bool2Vis}}"/>
                    <Border Width="1" Height="20" Background="{DynamicResource SA.Brush.Border.Default}"
                            Margin="{DynamicResource SA.Gap.3}"/>
                    <Button Command="{Binding ImportCommand}" Style="{StaticResource SA.Button.Secondary}"
                            Margin="{DynamicResource SA.Gap.Right2}">
                        <StackPanel Orientation="Horizontal">
                            <ds:IconPresenter Data="{StaticResource SA.Icon.Import}" Margin="{DynamicResource SA.Gap.Right2}"
                                              Foreground="{DynamicResource SA.Brush.Text.Primary}"/>
                            <TextBlock Text="Import" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SaveCommand}" Style="{StaticResource SA.Button.Secondary}"
                            ToolTip="Saving arrives with the persistence UI (P01).">
                        <StackPanel Orientation="Horizontal">
                            <ds:IconPresenter Data="{StaticResource SA.Icon.Save}" Margin="{DynamicResource SA.Gap.Right2}"
                                              Foreground="{DynamicResource SA.Brush.Text.Secondary}"/>
                            <TextBlock Text="Save" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Center: active-context chip -->
                <Border Grid.Column="1" Style="{StaticResource SA.ActiveChip}" HorizontalAlignment="Center"
                        Visibility="{Binding HasActive, Converter={StaticResource Bool2Vis}}">
                    <TextBlock Text="{Binding ActiveContextText}" VerticalAlignment="Center"
                               Foreground="{DynamicResource SA.Brush.Accent.OnSurface}"
                               Style="{StaticResource SA.Text.BodyStrong}"/>
                </Border>

                <!-- Right: compare / theme / assistant -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SA.Button.Toolbar}" IsEnabled="False"
                            ToolTip="Compare arrives with the analysis UI." Margin="{DynamicResource SA.Gap.Right2}">
                        <StackPanel Orientation="Horizontal">
                            <ds:IconPresenter Data="{StaticResource SA.Icon.Compare}" Margin="{DynamicResource SA.Gap.Right2}"/>
                            <TextBlock Text="Compare" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ToggleThemeCommand}" Style="{StaticResource SA.Button.Toolbar}"
                            Margin="{DynamicResource SA.Gap.Right2}">
                        <StackPanel Orientation="Horizontal">
                            <ds:IconPresenter Data="{StaticResource SA.Icon.Theme}" Margin="{DynamicResource SA.Gap.Right2}"/>
                            <TextBlock Text="{Binding ThemeToggleLabel}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <ds:IconPresenter Data="{StaticResource SA.Icon.Assistant}"
                                      Foreground="{DynamicResource SA.Brush.Accent.OnSurface}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ Main body ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="300" MinWidth="240"/>
            </Grid.ColumnDefinitions>

            <!-- Left area: (explorer | active view) over history -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="232" MinWidth="180"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Explorer -->
                    <Border Grid.Column="0" Background="{DynamicResource SA.Brush.Background.Sidebar}"
                            BorderBrush="{DynamicResource SA.Brush.Border.Default}"
                            BorderThickness="{DynamicResource SA.Stroke.Hairline}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="WORKSPACE" Margin="{DynamicResource SA.Gap.3}"
                                       Style="{StaticResource SA.Text.SectionLabel}"/>
                            <TextBlock DockPanel.Dock="Bottom" Text="No datasets yet" Margin="{DynamicResource SA.Gap.3}"
                                       Style="{StaticResource SA.Text.Caption}"
                                       Visibility="{Binding IsEmpty, Converter={StaticResource Bool2Vis}}"/>
                            <TreeView x:Name="ExplorerTree" ItemsSource="{Binding ExplorerNodes}"
                                      SelectedItemChanged="ExplorerTree_SelectedItemChanged"
                                      Background="Transparent" BorderThickness="0">
                                <TreeView.ItemContainerStyle>
                                    <!-- keep lineage (derived children, attached measurements) visible -->
                                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource SA.TreeViewItem}">
                                        <Setter Property="IsExpanded" Value="True"/>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                            </TreeView>
                        </DockPanel>
                    </Border>

                    <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                  Background="{DynamicResource SA.Brush.Border.Default}"/>

                    <!-- Active view -->
                    <Border Grid.Column="2" Background="{DynamicResource SA.Brush.Surface.Default}">
                        <DockPanel>
                            <!-- header: active title + subtitle + shared-range tag (when an image is active) -->
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="40"
                                        Margin="{DynamicResource SA.Pad.Bar}"
                                        Visibility="{Binding HasActiveImage, Converter={StaticResource Bool2Vis}}">
                                <TextBlock Text="{Binding ActiveTitle}" VerticalAlignment="Center"
                                           Style="{StaticResource SA.Text.BodyStrong}"/>
                                <TextBlock Text="{Binding ActiveSubtitle}" VerticalAlignment="Center"
                                           Margin="{DynamicResource SA.Gap.Left2}" Style="{StaticResource SA.Text.Secondary}"/>
                                <Border VerticalAlignment="Center" Margin="{DynamicResource SA.Gap.Left2}"
                                        Background="{DynamicResource SA.Brush.Surface.Hover}"
                                        CornerRadius="{DynamicResource SA.Radius.Sm}" Padding="{DynamicResource SA.Gap.1}"
                                        Visibility="{Binding IsBeforeAfter, Converter={StaticResource Bool2Vis}}">
                                    <TextBlock Text="same X/Y · independent Z ranges" Style="{StaticResource SA.Text.Micro}"/>
                                </Border>
                            </StackPanel>
                            <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource SA.Brush.Border.Subtle}"
                                    Visibility="{Binding HasActiveImage, Converter={StaticResource Bool2Vis}}"/>

                            <Grid>
                                <!-- single 2D image -->
                                <ctl:AfmImageView x:Name="SingleImage"
                                                  Visibility="{Binding IsSingleImage, Converter={StaticResource Bool2Vis}}"/>

                                <!-- Before / After split -->
                                <Grid Visibility="{Binding IsBeforeAfter, Converter={StaticResource Bool2Vis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="1"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <DockPanel Grid.Column="0">
                                        <TextBlock DockPanel.Dock="Top" Text="BEFORE" Margin="{DynamicResource SA.Gap.2}"
                                                   Style="{StaticResource SA.Text.SectionLabel}"/>
                                        <ctl:AfmImageView x:Name="BeforeImageView"/>
                                    </DockPanel>
                                    <Border Grid.Column="1" Background="{DynamicResource SA.Brush.Border.Default}"/>
                                    <DockPanel Grid.Column="2">
                                        <TextBlock DockPanel.Dock="Top" Text="AFTER" Margin="{DynamicResource SA.Gap.2}"
                                                   Style="{StaticResource SA.Text.SectionLabel}"/>
                                        <ctl:AfmImageView x:Name="AfterImageView"/>
                                    </DockPanel>
                                </Grid>

                            <!-- empty: first-run -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Visibility="{Binding IsEmpty, Converter={StaticResource Bool2Vis}}">
                                <ds:IconPresenter Data="{StaticResource SA.Icon.FolderOpen}" Width="40" Height="40"
                                                  Foreground="{DynamicResource SA.Brush.Text.Tertiary}"
                                                  HorizontalAlignment="Center" Margin="{DynamicResource SA.Gap.Bottom2}"/>
                                <TextBlock Text="No workspace open" HorizontalAlignment="Center"
                                           Style="{StaticResource SA.Text.Subtitle}"/>
                                <TextBlock Text="Open a scan, or start with the bundled sample."
                                           HorizontalAlignment="Center" Margin="{DynamicResource SA.Gap.Bottom2}"
                                           Style="{StaticResource SA.Text.Secondary}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Command="{Binding ImportCommand}" Content="Import scan…"
                                            Style="{StaticResource SA.Button.Primary}" Margin="{DynamicResource SA.Gap.Right2}"/>
                                    <Button Command="{Binding OpenSampleCommand}" Content="Open sample"
                                            Style="{StaticResource SA.Button.Secondary}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- status banner (errors) -->
                            <Border VerticalAlignment="Bottom" Style="{StaticResource SA.Banner.Error}"
                                    Margin="{DynamicResource SA.Gap.3}"
                                    Visibility="{Binding HasStatus, Converter={StaticResource Bool2Vis}}">
                                <StackPanel Orientation="Horizontal">
                                    <ds:IconPresenter Data="{StaticResource SA.Icon.Error}" Margin="{DynamicResource SA.Gap.Right2}"
                                                      Foreground="{DynamicResource SA.Brush.Banner.Error.Foreground}"/>
                                    <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource SA.Brush.Banner.Error.Foreground}"
                                               Style="{StaticResource SA.Text.Body}"/>
                                </StackPanel>
                            </Border>
                            </Grid>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- History (bottom, under explorer + active view) -->
                <Border Grid.Row="1" Height="140" Background="{DynamicResource SA.Brush.Background.Sidebar}"
                        BorderBrush="{DynamicResource SA.Brush.Border.Default}"
                        BorderThickness="{DynamicResource SA.Stroke.Hairline}">
                    <DockPanel Margin="{DynamicResource SA.Gap.3}">
                        <TextBlock DockPanel.Dock="Top" Text="HISTORY · PROVENANCE"
                                   Margin="{DynamicResource SA.Gap.Bottom2}" Style="{StaticResource SA.Text.SectionLabel}"/>
                        <ItemsControl ItemsSource="{Binding HistoryRows}"/>
                    </DockPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="{DynamicResource SA.Brush.Border.Default}"/>

            <!-- Parameters (right, full height) -->
            <Border Grid.Column="2" Background="{DynamicResource SA.Brush.Surface.Default}"
                    BorderBrush="{DynamicResource SA.Brush.Border.Default}"
                    BorderThickness="{DynamicResource SA.Stroke.Hairline}">
                <DockPanel Margin="{DynamicResource SA.Gap.3}">
                    <TextBlock DockPanel.Dock="Top" Text="PARAMETERS" Margin="{DynamicResource SA.Gap.Bottom2}"
                               Style="{StaticResource SA.Text.SectionLabel}"/>
                    <Grid>
                        <!-- contextual Flatten panel (active dataset is an image). The outer Grid binds
                             Visibility on the shell VM (HasActiveImage); the inner panel switches DataContext
                             to the FlattenPanel VM so its fields bind — the two must not share one element. -->
                        <Grid Visibility="{Binding HasActiveImage, Converter={StaticResource Bool2Vis}}">
                        <StackPanel DataContext="{Binding FlattenPanel}">
                            <TextBlock Text="Flatten" Style="{StaticResource SA.Text.Title}"/>
                            <TextBlock Text="Subtract a per-line, averaged, or surface polynomial."
                                       Margin="{DynamicResource SA.Gap.Bottom2}" TextWrapping="Wrap"
                                       Style="{StaticResource SA.Text.Secondary}"/>

                            <TextBlock Text="Scope" Style="{StaticResource SA.Text.Caption}"/>
                            <ComboBox ItemsSource="{Binding ScopeOptions}" SelectedItem="{Binding Scope}"
                                      Margin="{DynamicResource SA.Gap.Bottom2}"/>

                            <TextBlock Text="Order (0–8)" Style="{StaticResource SA.Text.Caption}"/>
                            <ComboBox ItemsSource="{Binding OrderOptions}" SelectedItem="{Binding Order}"
                                      Margin="{DynamicResource SA.Gap.Bottom2}"/>

                            <TextBlock Text="Orientation" Style="{StaticResource SA.Text.Caption}"/>
                            <ComboBox ItemsSource="{Binding OrientationOptions}" SelectedItem="{Binding Orientation}"
                                      IsEnabled="{Binding OrientationEnabled}" Margin="{DynamicResource SA.Gap.Bottom2}"/>

                            <TextBlock Text="Basement" Style="{StaticResource SA.Text.Caption}"/>
                            <ComboBox ItemsSource="{Binding BasementOptions}" SelectedItem="{Binding Basement}"
                                      Margin="{DynamicResource SA.Gap.Bottom2}"/>

                            <Border Style="{StaticResource SA.Banner.Error}" Margin="{DynamicResource SA.Gap.Bottom2}"
                                    Visibility="{Binding HasError, Converter={StaticResource Bool2Vis}}">
                                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Style="{StaticResource SA.Text.Caption}"/>
                            </Border>
                            <Border Style="{StaticResource SA.Banner.Warning}" Margin="{DynamicResource SA.Gap.Bottom2}"
                                    Visibility="{Binding HasWarnings, Converter={StaticResource Bool2Vis}}">
                                <TextBlock Text="{Binding Warnings}" TextWrapping="Wrap" Style="{StaticResource SA.Text.Caption}"/>
                            </Border>

                            <Button Content="Apply" Command="{Binding ApplyCommand}" HorizontalAlignment="Left"
                                    Style="{StaticResource SA.Button.Primary}"/>
                        </StackPanel>
                        </Grid>

                        <!-- placeholder (no image active) -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding HasActiveImage, Converter={StaticResource NotBool2Vis}}">
                            <ds:IconPresenter Data="{StaticResource SA.Icon.Parameters}" Width="20" Height="20"
                                              HorizontalAlignment="Center" Margin="{DynamicResource SA.Gap.Bottom2}"/>
                            <TextBlock Text="Select an image" HorizontalAlignment="Center"
                                       Style="{StaticResource SA.Text.Secondary}"/>
                            <TextBlock Text="Contextual parameters appear here." HorizontalAlignment="Center"
                                       TextAlignment="Center" Style="{StaticResource SA.Text.Micro}"/>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

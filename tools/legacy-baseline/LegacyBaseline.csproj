<Project Sdk="Microsoft.NET.Sdk">

  <!-- TASK-MV00 legacy-baseline harness. NOT product code: lives outside src/, is NOT in
       SmartAnalysis.sln, and never ships. It drives the clean legacy numeric primitives to freeze
       golden data for parity tests (T01/T02/A01/A02).

       It compiles the legacy .cs BY PATH (read-only) — legacy source is never copied into this repo.
       Set LegacyCalcDir (or the LEGACY_CALC_DIR env var) to the legacy FW.Analysis.Calculate folder.
       There is NO machine-specific default; the manifest's git provenance is derived from THIS same
       directory (see Program.cs) so the golden's recorded commit always matches the compiled source.
       Requires the legacy repo present; it does not build in CI (excluded from the product solution). -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <LegacyCalcDir Condition="'$(LegacyCalcDir)' == ''">$(LEGACY_CALC_DIR)</LegacyCalcDir>

    <!-- Two calculators (A03 roughness, A08 line power spectrum) speak in FW.Data.Quantity types, so the
         harness needs that project's Model/Value/Interface folders as well. Those three are plain BCL code —
         the WPF and System.Drawing dependencies its csproj declares are reached only from the RawToReal*
         files at the project root, which are not compiled here and which nothing below needs. Derived from
         LegacyCalcDir rather than supplied separately: the manifest's git provenance comes from that same
         directory, and two paths could name two different checkouts. -->
    <LegacyQuantityDir Condition="'$(LegacyQuantityDir)' == '' and '$(LegacyCalcDir)' != ''">$([System.IO.Path]::GetFullPath('$(LegacyCalcDir)\..\..\Data\FW.Data.Quantity'))</LegacyQuantityDir>
  </PropertyGroup>

  <Target Name="_RequireLegacyCalcDir" BeforeTargets="CoreCompile" Condition="'$(LegacyCalcDir)' == ''">
    <Error Text="LegacyCalcDir is not set. Pass -p:LegacyCalcDir=&lt;path&gt; or set the LEGACY_CALC_DIR env var to the legacy FW.Analysis.Calculate folder (read-only)." />
  </Target>

  <ItemGroup>
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
  </ItemGroup>

  <!-- Record the exact directory the legacy source was compiled from, so the runtime derives git
       provenance (commit/branch/dirty) from the SAME repo — not a separately-supplied path. -->
  <ItemGroup Condition="'$(LegacyCalcDir)' != ''">
    <AssemblyMetadata Include="LegacyCalcDir" Value="$(LegacyCalcDir)" />
  </ItemGroup>

  <!-- The quantity folders are compiled too, so the dirty-tree guard has to see them: a golden generated
       over edited quantity source would record a commit that does not reproduce it. -->
  <ItemGroup Condition="'$(LegacyQuantityDir)' != ''">
    <AssemblyMetadata Include="LegacyQuantityDir" Value="$(LegacyQuantityDir)" />
  </ItemGroup>

  <ItemGroup Condition="'$(LegacyCalcDir)' != ''">
    <!-- Legacy numeric primitives, compiled by path (NOT copied into this repo). -->
    <Compile Include="$(LegacyCalcDir)\SummaryStatisticsCalculator.cs">
      <Link>Legacy\SummaryStatisticsCalculator.cs</Link>
    </Compile>
    <Compile Include="$(LegacyCalcDir)\PolynomialLeastSquaresRegression.cs">
      <Link>Legacy\PolynomialLeastSquaresRegression.cs</Link>
    </Compile>
    <Compile Include="$(LegacyCalcDir)\BaselineCorrction.cs">
      <Link>Legacy\BaselineCorrction.cs</Link>
    </Compile>
    <Compile Include="$(LegacyCalcDir)\MultiplePolynomialRegression.cs">
      <Link>Legacy\MultiplePolynomialRegression.cs</Link>
    </Compile>
    <Compile Include="$(LegacyCalcDir)\RoughnessCalculator.cs">
      <Link>Legacy\RoughnessCalculator.cs</Link>
    </Compile>
    <Compile Include="$(LegacyCalcDir)\LinePowerSpectrumCalculator.cs">
      <Link>Legacy\LinePowerSpectrumCalculator.cs</Link>
    </Compile>
  </ItemGroup>

  <ItemGroup Condition="'$(LegacyQuantityDir)' != ''">
    <!-- Whole folders rather than a hand-listed closure: the quantity types cross-reference each other
         freely, and a list would go stale the first time legacy adds a unit. -->
    <Compile Include="$(LegacyQuantityDir)\Model\*.cs">
      <Link>Legacy\Quantity\Model\%(Filename)%(Extension)</Link>
    </Compile>
    <Compile Include="$(LegacyQuantityDir)\Value\*.cs">
      <Link>Legacy\Quantity\Value\%(Filename)%(Extension)</Link>
    </Compile>
    <Compile Include="$(LegacyQuantityDir)\Interface\*.cs">
      <Link>Legacy\Quantity\Interface\%(Filename)%(Extension)</Link>
    </Compile>
    <!-- The one file in those folders that reaches outside them: it needs FW.Data.Common's EAxisName and the
         RawToReal* types at the project root, which is the WPF-dependent corner. Nothing the calculators use
         refers to it, so it is dropped rather than dragging that corner in behind it. -->
    <Compile Remove="$(LegacyQuantityDir)\Interface\IRawToRealManager.cs" />
  </ItemGroup>

</Project>

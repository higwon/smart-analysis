<Project Sdk="Microsoft.NET.Sdk">

  <!-- Role: initial single test project. Hosts the project-reference Architecture Guard (reads the
       .csproj graph) and unit tests for the projects under test. References the xUnit test framework
       (Approved, doc 20) plus the product projects it tests (from F01: Domain). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Concrete DI container — to test the explicit per-module registration end-to-end (F04). -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Projects under test (F01: Domain; F04: Analysis; FF01: Application port + Infrastructure adapter).
         A test project may reference any product project to test it — the "only App references
         Infrastructure" rule is about product wiring and exempts the test project (arch guard). -->
    <ProjectReference Include="..\..\src\SmartAnalysis.Domain\SmartAnalysis.Domain.csproj" />
    <ProjectReference Include="..\..\src\SmartAnalysis.Analysis\SmartAnalysis.Analysis.csproj" />
    <ProjectReference Include="..\..\src\SmartAnalysis.Application\SmartAnalysis.Application.csproj" />
    <ProjectReference Include="..\..\src\SmartAnalysis.Infrastructure\SmartAnalysis.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\SmartAnalysis.Visualization\SmartAnalysis.Visualization.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Committed real-file fixtures (ADR-015): copied next to the test assembly so tests can read them. -->
    <None Include="Fixtures\Tiff\*.tiff" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
